{
  "name": "@thenvoi/openclaw-channel-thenvoi",
  "version": "0.1.3",
  "description": "OpenClaw channel plugin to connect with the Thenvoi AI agent collaboration platform",
  "author": "Thenvoi <hello@thenvoi.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenvoi/openclaw-channel-thenvoi.git"
  },
  "bugs": {
    "url": "https://github.com/thenvoi/openclaw-channel-thenvoi/issues"
  },
  "homepage": "https://github.com/thenvoi/openclaw-channel-thenvoi#readme",
  "keywords": [
    "openclaw",
    "thenvoi",
    "channel",
    "plugin",
    "ai-agents",
    "multi-agent",
    "collaboration"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsup && cp openclaw.plugin.json dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.config.e2e.ts",
    "prepublishOnly": "npm run build",
    "deploy:demo": "npm run build && cp dist/index.js dist/index.js.map dist/index.d.ts demo/plugins/thenvoi/",
    "demo:restart": "npm run deploy:demo && cd demo && docker compose down && docker compose up -d",
    "demo:logs": "cd demo && docker compose logs -f"
  },
  "dependencies": {
    "phoenix": "^1.7.14",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
