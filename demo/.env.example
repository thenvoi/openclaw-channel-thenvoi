# OpenClaw + Thenvoi Demo Environment Variables
# Copy this file to .env and fill in your values
#
# SECURITY: Never commit .env to version control!

# ═══════════════════════════════════════════════════════════════════
# OPENCLAW CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Required: Gateway authentication token
# Generate with: openclaw doctor --generate-gateway-token
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# ═══════════════════════════════════════════════════════════════════
# LLM PROVIDER API KEYS
# ═══════════════════════════════════════════════════════════════════

# Required: Anthropic API key for Claude models
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=sk-your-openai-key-here

# ═══════════════════════════════════════════════════════════════════
# THENVOI CHANNEL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Required: API key for Thenvoi authentication
THENVOI_API_KEY=tv_your_api_key_here

# Required: Your agent's identifier on Thenvoi
THENVOI_AGENT_ID=your-agent-uuid-here

# Required: User identifier associated with API key
THENVOI_API_KEY_USER=your-user-uuid-here

# Optional: Thenvoi WebSocket endpoint (defaults to production)
# Note: Use base socket URL - Phoenix appends /websocket automatically
# THENVOI_WS_URL=wss://api.thenvoi.com/socket

# Optional: Thenvoi REST API endpoint (defaults to production)
# THENVOI_REST_URL=https://api.thenvoi.com

# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT / TESTING
# ═══════════════════════════════════════════════════════════════════

# Uncomment for Thenvoi dev environment:
# THENVOI_WS_URL=wss://platform.dev.thenvoi.com/api/v1/socket
# THENVOI_REST_URL=https://platform.dev.thenvoi.com
